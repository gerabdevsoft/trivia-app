{
  "expo": {
    "name": "Trivia GerabDevSoft",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.quizpointsraffle.fy1s6l",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Subir imágenes de premios al panel administrativo"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#002954"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.quizpointsraffle.fy1s6l",
      "googleServicesFile": "./google-services.json",
      "permissions": ["READ_EXTERNAL_STORAGE", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app accede a tus fotos para subir imágenes de premios."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#002954"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
